class Solution {
    public static int optimalSearchTree(int keys[], int freq[], int n) {
        int[][] dp = new int[n][n];
        
        for (int i = 0; i < n; i++) {
            dp[i][i] = freq[i];
        }
        
        for (int length = 2; length <= n; length++) {
            for (int i = 0; i <= n - length; i++) {
                int j = i + length - 1;
                dp[i][j] = Integer.MAX_VALUE;
                
                for (int root = i; root <= j; root++) {
                    int leftCost = (root > i) ? dp[i][root - 1] : 0;
                    int rightCost = (root < j) ? dp[root + 1][j] : 0;
                    int totalCost = leftCost + rightCost + freqSum(freq, i, j);
                    dp[i][j] = Math.min(dp[i][j], totalCost);
                }
            }
        }
        
        return dp[0][n - 1];
    }
    
    private static int freqSum(int freq[], int i, int j) {
        int sum = 0;
        for (int k = i; k <= j; k++) {
            sum += freq[k];
        }
        return sum;
    }
}

